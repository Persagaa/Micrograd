    #它用于检查某个条件是否为真，如果条件为假，则抛出一个AssertionError异常。
    #assert语句通常用于调试和测试代码，以确保代码的正确性。
    #assert语句的语法如下：
    #assert condition

def test_more_ops():
    a=Value(-4.0)
    b=Value(2.0)
    c=a+b
    d=a*b+b**3
    c+=c+1
    c+=1+c+(-a)
    d+=d*2+(b+a).relu()
    d+=3*d+(b-a).relu()
    e=c-d
    f=e**2
    g=f/2.0
    g+=10.0/f
    g.backward()
    amg,bmg,gmg=a,b,g
    print(f"amg:{amg},bmg:{bmg},gmg:{gmg}")

    a=torch.Tensor([-4.0]).double()
    b=torch.Tensor([2.0]).double()
    a.requires_grad=True
    b.requires_grad=True
    c=a+b
    d=a*b+b**3
    c=c+c+1
    c=c+1+c+(-a)
    d=d+d*2+(b+a).relu()
    d=d+3*d+(b-a).relu()
    e=c-d
    f=e**2
    g=f/2.0
    g=g+10.0/f
    g.backward()
    apt,bpt,gpt=a,b,g
    print(f"apt:{apt},bpt:{bpt},gpt:{gpt}")

    tol=1e-6
    #tol的作用是什么？
    #tol是tolerance的缩写，表示容差或误差范围。
    #在计算中，tol用于指定允许的误差范围，以判断计算结果是否满足要求。
    #例如，在数值计算中，如果计算结果的误差小于tol，则认为计算是准确的。

    assert abs(gmg.data-gpt.data.item())<tol
    assert abs(amg.grad-apt.grad.item())<tol
    assert abs(bmg.data-bpt.data.item())<tol


if __name__=="__main__":
    test_sanity_check()
    test_more_ops()
    print("All tests passed!")