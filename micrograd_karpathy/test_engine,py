import torch
from engine import Value

def test_sanity_check():
    x=Value(-4.0)
    z=2*x+2+x
    q=z.relu()+z*x
    h=(z*z).relu()
    y=h+q+q*x
    y.backward()
    xmg,ymg=x,y
    print(f"xmg:{xmg},ymg:{ymg}")

#为什么中间用激活函数？
#激活函数是神经网络中的一种非线性函数，用于引入非线性特性，
# 使神经网络能够学习复杂的模式。
# 在这个例子中，relu函数用于将输入值限制在非负范围内，
# 从而引入非线性特性。
#relu和tanh哪个更好？
#relu函数和tanh函数都是常用的激活函数，它们各有优缺点。
#relu函数的优点是计算简单，收敛速度快，但在训练深层神经网络时容易出现梯度消失问题。
#tanh函数的优点是输出值在-1到1之间，可以更好地表示数据的范围，但在计算上比relu函数复杂。
#因此，选择哪个激活函数取决于具体的应用场景和需求。
#relu求导怎么算？
#relu函数的导数可以通过以下方式计算：
#如果输入x大于0，则relu函数的导数为1；
#如果输入x小于等于0，则relu函数的导数为0。
#因此，relu函数的导数可以表示为：
#f'(x) = 1 if x > 0
#f'(x) = 0 if x <= 0

#为什么用了pyTorch还要用Value
#PyTorch是一个深度学习框架，它提供了许多用于构建和训练神经网络的工具和函数。
#Value类是一个自定义的类，用于表示一个数值对象，它具有一些与数值计算相关的属性和方法。
#在这个例子中，Value类用于表示一个数值对象x，并将其与PyTorch的Tensor对象进行比较。
    x=torch.Tensor([-4.0]).double()
    x.requires_grad=True
    z=2*x+2+x
    q=z.relu()+z*x
    h=(z*z).relu()
    y=h+q+q*x
    y.backward()
    xpt,ypt=x,y

    print(f"xpt:{xpt},ypt:{ypt}")
    #forward pass went well
    assert ymg.data==ypt.data.item()
    #backward pass went well
    assert xmg.grad==xpt.grad.item()

